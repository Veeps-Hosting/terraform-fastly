{
  "_meta": {
    "name": "WAF efficacy corpus",
    "purpose": "Signature-shaped but BENIGN probes to measure what a WAF layer catches vs lets through. Nothing here exploits anything: payloads target non-existent/benign paths, point at RFC-invalid sinks (.invalid), and carry a test marker. No credential stuffing, no real webshell bodies, no volumetric flooding.",
    "profile_source": "a representative production WAF detection distribution (30-day sample)",
    "verdict_semantics": "expect=block -> a WAF SHOULD stop it; counting these as PASSED = attack-signature got through. expect=pass -> legitimate traffic; counting these as BLOCKED = false positive.",
    "weighting": "weight mirrors the observed 30d category volume so a weighted sample resembles real attack traffic",
    "payload_safety": "All sinks are .invalid or benign markers; traversal targets /etc/passwd only as a *string* against a path that 404s; JNDI/SSRF point at non-resolving .invalid hosts; command/code-injection use harmless tokens (id, phpinfo-as-string) never destructive commands."
  },
